      "versionCode": 1,
      "minSdkVersion": 21,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "__COLE_SEU_PROJECT_ID_AQUI__"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
